# Gemini API Key for server-side AI academic intelligence
GEMINI_API_KEY=

# Firebase Web API Key (populated from firebase-applet-config.json)
FIREBASE_API_KEY=

# Optional Firebase project ID for server-side ID-token verification (falls back to app config).
FIREBASE_PROJECT_ID=

# Optional trusted reverse-proxy hop count for correct client IP quotas; leave unset when directly exposed.
# Only set this when your ingress sanitizes forwarded headers. `true` means one trusted hop.
# TRUST_PROXY=1
